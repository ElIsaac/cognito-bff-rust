# Desarrollo local (cargo run -p lambda --features local). Copia a .env y rellena.
# Solo valores de ejemplo: .env esta ignorado por git.

PUBLIC_ORIGIN=http://localhost:5173
COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_EXAMPLE
COGNITO_DOMAIN=https://auth.example.com
COGNITO_CLIENT_ID=exampleclientid
# En local el nombre solo elige la variable de entorno (debe contener "client").
COGNITO_CLIENT_SECRET_ARN=client-secret-local
COGNITO_CLIENT_SECRET=cambia-esto
SESSIONS_TABLE=bff-sessions
UPSTREAM_BASE_URL=http://localhost:3000

# DynamoDB Local (solo se lee con --features local).
DYNAMODB_ENDPOINT_URL=http://localhost:8000
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Opcional.
# LOCAL_ADDR=127.0.0.1:8787
# ORIGIN_VERIFY_SECRET_ARN=origin-verify-local
# ORIGIN_VERIFY_SECRET=cambia-esto
# ORIGIN_VERIFY_PREVIOUS_GRACE_SECS=900
# REQUEST_BUDGET_SECS=14
# EXPOSED_CLAIMS=custom:tenant_id
RUST_LOG=info
