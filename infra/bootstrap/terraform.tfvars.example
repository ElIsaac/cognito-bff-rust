# cp terraform.tfvars.example terraform.tfvars
# La passphrase NO va aqui: export TF_VAR_bootstrap_passphrase=$(openssl rand -base64 32)

region            = "us-east-2"
project           = "cognito-bff"
github_owner      = "OWNER"
github_repo       = "REPO-DE-ENVS"
envs              = ["dev", "prod"]
state_bucket_name = "mi-empresa-cognito-bff-tfstate"
kms_alias         = "alias/cognito-bff-state"

# Solo hay un proveedor OIDC de GitHub por cuenta.
create_github_oidc_provider       = true
existing_github_oidc_provider_arn = null
# existing_github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# Buckets de la SPA que el modulo cloudfront protege con bucket policy, y pools de Cognito
# donde se crea el app client (obligatorio, al menos uno).
spa_bucket_arns        = ["arn:aws:s3:::mi-empresa-spa-dev", "arn:aws:s3:::mi-empresa-spa-prod"]
cognito_user_pool_arns = ["arn:aws:cognito-idp:us-east-2:123456789012:userpool/us-east-2_AbCdEfGhI"]

tags = {
  Owner = "plataforma"
}

# Fuera del prefijo `<project>-<env>*`: tablas, secretos y llaves que la Lambda usa y que el
# techo de sus roles debe admitir (vacio = solo lo que lleva el prefijo).
lambda_extra_table_arns  = []
lambda_extra_secret_arns = []
# Solo con upstream_auth = "aws_iam": Lambdas cuya Function URL invoca el BFF.
lambda_upstream_function_arns = []
lambda_kms_key_arns      = []
